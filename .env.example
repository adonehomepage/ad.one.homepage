# 브랜드 / 서비스 (출시 전 확정 필요)
APP_NAME=브랜드명미정
# local | preview(Vercel Preview=dev) | production(Vercel Production=prod)
APP_ENV=local
APP_PUBLIC_URL=http://localhost:3000
APP_ADMIN_URL=http://localhost:3000
APP_TIMEZONE=Asia/Seoul

# 조직 및 기본 정책 (추천 기본값)
DEFAULT_PROJECT_DURATION_MONTHS=3
EXPIRY_NOTICE_DAYS_BEFORE=7
PROJECT_PURGE_GRACE_DAYS=30
MAX_PUBLISHED_VERSIONS=5
MAX_SECTION_COPIES_PER_ORIGINAL=3
MAX_ADVERTISER_RECIPIENTS=5
LEAD_RETENTION_MONTHS=6
SLUG_REUSE_COOLDOWN_DAYS=365
MAX_DURATION_MONTHS=120

# 실제 고객 개인정보 수집 차단. 법인·처리 주체 확정 후 true로 변경.
LEAD_COLLECTION_ENABLED=false
# prod에서 관심고객 관리 UI 강제 노출(수집과 별개). 비우면 prod=수집여부, non-prod=노출.
# FEATURE_LEAD_ADMIN=true
# Preview에서도 cron 실작업(기본은 Production만). 로컬은 기본 허용.
# CRON_ALLOW_NON_PROD=true

# DB / 인증 — 로컬 docker-compose 기본값. Preview/Prod는 Vercel에 서로 다른 DATABASE_URL.
DATABASE_URL=postgres://adit:adit_local_dev@localhost:5433/adit_landing
# 0이면 환경별 자동(로컬 10, Vercel/preview/production 1)
DB_POOL_MAX=0
SESSION_SECRET=replace-with-32-byte-random-string

# 최초 시스템 관리자 시드 (로컬 전용 · Vercel에는 넣지 마세요)
SEED_ADMIN_LOGIN=teamadit
SEED_ADMIN_PASSWORD="!adit1017"
SEED_ADMIN_NAME=시스템 관리자
SEED_ORG_NAME=광고사명미정

# 파일 저장소 — 로컬: local / Vercel Preview·Production: s3 (S3 또는 R2)
STORAGE_PROVIDER=local
STORAGE_BUCKET_PUBLIC=public-assets
STORAGE_BUCKET_PRIVATE=private-assets
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/media
STORAGE_LOCAL_ROOT=./storage
S3_ENDPOINT=
S3_REGION=ap-northeast-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# 이메일 / 알림톡 — 미설정 시 샌드박스 어댑터만 동작
EMAIL_PROVIDER=sandbox
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

KAKAO_MESSAGE_PROVIDER=sandbox
KAKAO_CHANNEL_ID=
KAKAO_CHANNEL_NAME=
KAKAO_PROVIDER_API_KEY=
KAKAO_TEMPLATE_LEAD_REGISTERED=
KAKAO_TEMPLATE_EXPIRY_NOTICE=

SMS_FALLBACK_ENABLED=false
SMS_PROVIDER_API_KEY=
SMS_REGISTERED_SENDER_NUMBER=

CRON_SECRET=replace-with-cron-secret
NOTIFICATION_WEBHOOK_SECRET=

# 개인정보 및 법인 정보 (출시 전 확정 필요)
LEGAL_COMPANY_NAME=
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_POLICY_URL=
PII_ENCRYPTION_KEY=
PII_LOOKUP_HMAC_KEY=

ERROR_MONITORING_DSN=

# --- Vercel Preview(dev) 예시 (값은 Vercel UI에만) ---
# APP_ENV=preview
# APP_PUBLIC_URL=https://your-preview.vercel.app
# APP_ADMIN_URL=https://your-preview.vercel.app
# DATABASE_URL=postgres://...dev...
# STORAGE_PROVIDER=s3
# STORAGE_PUBLIC_BASE_URL=https://cdn-dev.example.com
# LEAD_COLLECTION_ENABLED=false

# --- Vercel Production(prod) 예시 ---
# APP_ENV=production
# APP_PUBLIC_URL=https://www.example.com
# APP_ADMIN_URL=https://www.example.com
# DATABASE_URL=postgres://...prod...
# STORAGE_PROVIDER=s3
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
# LEAD_COLLECTION_ENABLED=false
